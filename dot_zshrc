# [general]
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt APPEND_HISTORY        # 追加写入，而不是覆盖
# setopt INC_APPEND_HISTORY    # 每执行一条命令就立刻写入磁盘
setopt SHARE_HISTORY         # 多个终端会话共享历史

# [environment] 应该放在开头，否则命令可能找不到
export PATH=$PATH:~/.local/bin
# export EDITOR=helix
export EDITOR='code --wait'


# [plugins]
autoload -Uz compinit;compinit
# [plugins.fzf-tab]
# git clone https://github.com/Aloxaf/fzf-tab ~/.zsh-plugins/fzf-tab
# source ~/.zsh-plugins/fzf-tab/fzf-tab.plugin.zsh

# [arch.plugins.zsh-autosuggestions & zsh-syntax-highlighting]
[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# [ubuntu.plugins.zsh-autosuggestions & zsh-syntax-highlighting]
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# [init]
eval "$(starship init zsh)"
eval "$(zoxide init zsh --cmd cd)"
eval "$(fzf --zsh)"
eval "$(uv generate-shell-completion zsh)"
eval "$(uvx --generate-shell-completion zsh)"

# [alias]
alias hx='helix'
alias ls='eza --icons --git'
alias ll='eza -l --icons --git --time-style relative'
alias lt='eza --tree --level=2 --icons'

# [functions]
# [functions.yazi]
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

# [functions.pproxy] use clash proxy for a command
pproxy() {
  local default="http://127.0.0.1:7890"
  local proxy

  case "$1" in
    http://*|https://*)
      proxy="$1"; shift ;;
    *)
      proxy="${INTERNAL_PROXY_URL:-$default}" ;;
  esac

  [ $# -gt 0 ] || { echo "用法: pproxy [http(s)://proxy] <命令> [参数...]" >&2; return 1; }

  echo "==> proxy=$proxy cmd=$*"
  env http_proxy="$proxy" https_proxy="$proxy" all_proxy="$proxy" "$@"
}
