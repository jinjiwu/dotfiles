source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
autoload -Uz compinit
compinit

eval "$(starship init zsh)"
eval "$(zoxide init zsh --cmd cd)"
eval "$(fzf --zsh)"
eval "$(uv generate-shell-completion zsh)"
eval "$(uvx --generate-shell-completion zsh)"

export PATH=$PATH:~/.local/bin

# alias

# function
pproxy() {
    local proxy_url
    # 在这里定义你的默认代理地址
    local default_proxy_url="http://127.0.0.1:7890"

    # 1. 检查第一个参数是否是代理地址
    case "$1" in
        http://*|https://*)
            proxy_url="$1"
            shift # 移除代理地址参数，剩下的是要执行的命令
            ;;
        *)
            # 2. 如果不是，则尝试从环境变量获取，如果环境变量也为空，则使用默认值
            #    语法 ${VAR:-default} 表示：如果 $VAR 存在且不为空，则使用 $VAR 的值，否则使用 default 的值。
            proxy_url="${INTERNAL_PROXY_URL:-$default_proxy_url}"
            ;;
    esac

    # 3. 检查是否还有要执行的命令
    if [ $# -eq 0 ]; then
        echo "错误：没有提供要执行的命令。" >&2
        echo "用法: pproxy [代理地址] <命令>" >&2
        return 1
    fi

    # 4. 使用代理执行命令
    echo "==> 使用代理 [${proxy_url}] 执行: $@"
    env \
      http_proxy="$proxy_url" \
      https_proxy="$proxy_url" \
      "$@"
}