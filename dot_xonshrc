# [plugins]
# auto free cwd xontrib
# xpip install xontrib-prompt-starship xontrib-coreutils
xontrib load free_cwd
xontrib load coreutils
xontrib load prompt_starship
xontrib load fzf-widgets

# [alias]
# [alias.eza] 添加 --icons 显示图标，--git 显示 git 状态，--header 显示表头
aliases['ls'] = ['eza', '-l', '--icons', '--git', '--header']
# [alias.bat] 使用 bat 代替 cat，带语法高亮和行号
aliases['cat'] = ['bat']
